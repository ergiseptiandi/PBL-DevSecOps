# Salin file ini menjadi .env lalu isi nilai rahasia.
#   cp .env.example .env
# .env tidak boleh di-commit (sudah di .gitignore).

# --- Database ---
POSTGRES_USER=tasks
POSTGRES_PASSWORD=
POSTGRES_DB=tasks

# --- Versi aplikasi untuk demo blue-green (tampil di badge UI) ---
BACKEND_BLUE_VERSION=1.0.0
BACKEND_GREEN_VERSION=1.1.0

# --- Backend yang sedang aktif di belakang Nginx ---
ACTIVE_BACKEND=backend-blue:8000

# --- Port edge yang dibuka ke publik ---
HTTP_PORT=8080

# --- CORS (frontend same-origin lewat edge nginx) ---
CORS_ORIGINS=http://localhost

# --- Rate limit API per IP ---
RATE_LIMIT=60/minute

# --- URL backend dari sudut pandang frontend (baked saat build) ---
# Lewat edge nginx agar switch blue/green otomatis ikut berlaku.
BACKEND_URL=http://nginx:80
