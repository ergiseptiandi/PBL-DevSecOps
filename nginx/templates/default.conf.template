# Nginx sebagai edge reverse proxy.
# File ini di-template oleh envsubst bawaan image nginx (variabel yang
# diganti HANYA variabel environment container, mis. ${ACTIVE_BACKEND}).
# Variabel nginx seperti $host / $remote_addr aman dan tidak terganggu.

upstream active_backend {
    server ${ACTIVE_BACKEND};
}

server {
    listen 80;
    server_name _;
    server_tokens off;
    client_max_body_size 256k;

    # Security headers di edge (defense in depth — backend juga mengirimnya)
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'" always;

    location = /healthz {
        default_type text/plain;
        return 200 'ok';
    }

    location /api/ {
        proxy_pass http://active_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
